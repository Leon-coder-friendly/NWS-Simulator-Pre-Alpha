{
  "name": "nws-simulator",
  "version": "0.4.0",
  "description": "A desktop severe-weather simulation interface",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node --test weather.test.js"
  },
  "dependencies": {
    "d3": "5.16.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "electron": "35.0.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.nws.simulator",
    "productName": "NWS Simulator",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NWS Simulator.${ext}"
    },
    "files": [
      "main.js",
      "renderer.js",
      "weather.js",
      "index.html",
      "styles.css",
      "METEOROLOGY.md",
      "package.json",
      "node_modules/**/*",
      "atmosphere.js",
      "thermodynamics.js",
      "hydrometeors.js",
      "locations.js",
      "lifecycle.js",
      "synoptic.js",
      "radar-sites.json",
      "forecast.js"
    ]
  }
}
